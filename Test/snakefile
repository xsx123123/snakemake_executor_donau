import time
import os
import random
import tempfile

# --- 配置区域 ---
# 1. 增加样本量到 100 个，测试调度器吞吐量
SAMPLE_COUNT = int(os.environ.get("SAMPLES", "100"))
if SAMPLE_COUNT < 1:
    raise ValueError("SAMPLES must be a positive integer")
SAMPLES = [f"sample_{i:03d}" for i in range(1, SAMPLE_COUNT + 1)]
# Defaults preserve the original cluster stress load. Explicit scaling enables
# the same memory/IO/CPU/retry workflow to run against a local CLI shim.
STRESS_SCALE = float(os.environ.get("DONAU_TEST_STRESS_SCALE", "1"))
if STRESS_SCALE <= 0:
    raise ValueError("DONAU_TEST_STRESS_SCALE must be positive")
TEST_QUEUE = os.environ.get("DONAU_TEST_QUEUE", "fat_x86")
CHAOS_RATE = float(os.environ.get("DONAU_TEST_CHAOS_RATE", "0.1"))
HOLD_SECONDS = float(os.environ.get("DONAU_TEST_HOLD_SECONDS", "0"))
RUNTIME_MINUTES = int(os.environ.get("DONAU_TEST_RUNTIME_MINUTES", "60"))
if not 0 <= CHAOS_RATE <= 1 or HOLD_SECONDS < 0 or RUNTIME_MINUTES < 1:
    raise ValueError("Invalid chaos rate, hold time or runtime")

rule all:
    input:
        "results/final_stress_report.txt"

# 步骤1：全方位压力测试 (CPU + MEM + IO + 随机失败)
rule hardcore_stress:
    output:
        "results/{sample}.result"
    resources:
        queue = TEST_QUEUE,
        # 动态资源：部分任务申请大内存，部分申请小内存，测试调度器的"拼图"能力
        mem_mb = lambda wildcards, attempt: 4096 if int(wildcards.sample.split('_')[1]) % 2 == 0 else 2048,
        runtime = RUNTIME_MINUTES
    threads: 1
    retries: 2  # 🌟 关键：如果任务失败，Snakemake 会自动重试 2 次
    run:
        import random

        # --- 0. 混沌测试 (模拟随机网络波动或节点故障) ---
        # 10% 的概率直接抛出异常，测试 Snakemake 的 retries 是否生效
        time.sleep(HOLD_SECONDS)
        should_fail = random.random() < CHAOS_RATE
        if os.environ.get("DONAU_TEST_DETERMINISTIC_FAILURES") == "1":
            marker = f".snakemake/mock_failures/{wildcards.sample}"
            should_fail = int(wildcards.sample.split('_')[1]) % 10 == 0 and not os.path.exists(marker)
            if should_fail:
                os.makedirs(os.path.dirname(marker), exist_ok=True)
                with open(marker, "w") as handle:
                    handle.write("first attempt failed\n")
        if should_fail:
            print("💀 触发随机故障 (Chaos Monkey)！模拟任务失败...")
            raise Exception("Random Chaos Failure triggered! Snakemake should retry this.")

        print(f"[{wildcards.sample}] Host: {os.uname().nodename}")

        # --- 1. 内存压力 (Memory Stress) ---
        # 申请 3GB (对于 4GB 的请求) 或 1.5GB (对于 2GB 的请求)
        target_mem_gb = (3.0 if int(wildcards.sample.split('_')[1]) % 2 == 0 else 1.5) * STRESS_SCALE
        print(f"🔥 [MEM] 正在分配 {target_mem_gb}GB 内存...")
        try:
            # 这里的 bytearray 会实打实地占用物理内存
            data_chunk = bytearray(max(200, int(target_mem_gb * 1024 * 1024 * 1024)))
            # 随机访问一下数组，防止操作系统进行"惰性分配" (Lazy Allocation)
            data_chunk[100] = 1
            data_chunk[-100] = 1
            print("✅ 内存分配且触达成功！")
        except MemoryError:
            raise MemoryError("❌ 内存分配失败！集群限制生效了。")

        # --- 2. IO 压力 (Disk Stress) ---
        # 模拟生信流程中的大量中间文件读写 (100MB)
        io_bytes = max(1, int(100 * 1024 * 1024 * STRESS_SCALE))
        print(f"🔥 [IO] 正在进行磁盘 I/O 读写测试 ({io_bytes} bytes)...")
        io_start = time.time()
        # 在当前目录下创建临时文件，测试网络文件系统的延迟
        temp_filename = f"{output[0]}.tmp_io_stress"
        with open(temp_filename, "wb") as f:
            # 写 100MB 随机数据
            f.write(os.urandom(io_bytes))

        # 读回来
        with open(temp_filename, "rb") as f:
            _ = f.read()

        # 删掉
        os.remove(temp_filename)
        io_duration = time.time() - io_start
        print(f"✅ IO 测试完成，耗时: {io_duration:.2f}s")

        # --- 3. CPU 压力 (Matrix Multiplication) ---
        # 纯 Python 进行 500x500 矩阵乘法，非常消耗 CPU
        size = max(2, int(500 * STRESS_SCALE))
        print(f"🔥 [CPU] 正在进行矩阵乘法 ({size}x{size})...")
        cpu_start = time.time()
        A = [[random.random() for _ in range(size)] for _ in range(size)]
        B = [[random.random() for _ in range(size)] for _ in range(size)]
        # 只是为了烤机，结果不重要，算一部分即可防止超时
        # 仅计算对角线部分以节省一点时间，但依然足够 heavy
        result = [sum(a * b for a, b in zip(A_row, B_col)) for A_row, B_col in zip(A, zip(*B))]

        cpu_duration = time.time() - cpu_start
        print(f"✅ CPU 测试完成，耗时: {cpu_duration:.2f}s")

        # --- 4. 写入结果 ---
        with open(output[0], "w") as f:
            f.write(f"Sample: {wildcards.sample}\n")
            f.write(f"Host: {os.uname().nodename}\n")
            f.write(f"MEM Allocated: {target_mem_gb}GB\n")
            f.write(f"IO Time: {io_duration:.2f}s\n")
            f.write(f"CPU Time: {cpu_duration:.2f}s\n")
            f.write("Status: Survived\n")

# 步骤2：汇总报告
rule summarize_all:
    input:
        expand("results/{sample}.result", sample=SAMPLES)
    output:
        "results/final_stress_report.txt"
    resources:
        queue = TEST_QUEUE,
        mem_mb = 1024
    threads: 1
    shell:
        """
        echo "=== 🌋 终极压力测试报告 ===" > {output}
        echo "完成时间: $(date)" >> {output}
        echo "成功样本数: $(ls results/*.result | wc -l) / {SAMPLE_COUNT}" >> {output}
        echo "" >> {output}
        echo "--- 节点负载分布 ---" >> {output}
        grep "Host" results/*.result | sort | uniq -c | sort -nr >> {output}
        echo "" >> {output}
        echo "--- 性能统计 (平均值) ---" >> {output}
        echo "平均 IO 耗时: $(grep "IO Time" results/*.result | awk '{{sum+=$3}} END {{print sum/NR}}') 秒" >> {output}
        echo "平均 CPU 耗时: $(grep "CPU Time" results/*.result | awk '{{sum+=$3}} END {{print sum/NR}}') 秒" >> {output}
        """
